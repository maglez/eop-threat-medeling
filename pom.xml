<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>org.maglez</groupId>
    <artifactId>ElevationOfPrivilegeEoP</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
        <commons-text.version>1.15.0</commons-text.version>

        <spotbugs.version>4.9.3.0</spotbugs.version>
        <jacoco.version>0.8.13</jacoco.version>
        <jacoco.min.instruction>0.80</jacoco.min.instruction>
        <jacoco.min.branch>0.70</jacoco.min.branch>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-text</artifactId>
                <version>${commons-text.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>
        <!-- Spring Boot 4 moved LiquibaseAutoConfiguration out of the monolithic
             autoconfigure jar into this module. Without it liquibase-core sits on
             the classpath doing nothing and every spring.liquibase.* property is
             inert, which is exactly the state this project was in: the changelog
             was configured, enabled, and never read. Nothing failed, because an
             unread changelog and an empty one are indistinguishable until the
             first migration exists. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-liquibase</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4 split the test slices out of spring-boot-test-autoconfigure.
             MockMvc support, and with it @AutoConfigureMockMvc, now lives in its own
             module and is no longer pulled in by spring-boot-starter-test. Without it
             the API contract could only be tested by starting a real servlet container
             on a port, which is slower and proves less about the web layer. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <violationSeverity>warning</violationSeverity>
                    <failOnViolation>true</failOnViolation>
                </configuration>
                <executions>
                    <execution>
                        <id>validate-style</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              Javadoc gate (EOP-120). The two halves of "missing + malformed" are enforced by
              two different tools on purpose.

              This plugin owns MALFORMED only: doclint's accessibility, html, reference and
              syntax groups catch broken {@link} targets, bad markup and mis-written tags,
              which Checkstyle cannot see.

              The `missing` group is switched OFF here and owned by Checkstyle instead
              (MissingJavadocType / MissingJavadocMethod / JavadocMethod in checkstyle.xml,
              all pinned to scope=public). Reason: doclint ignores the -public visibility
              flag when looking for absent comments and demands one on every private field,
              which would mean documenting ~50 private fields on the domain exception classes
              that are not public API. Checkstyle can be scoped to public members; doclint
              cannot. Do NOT "fix" this by writing doclint=all. And do not try
              doclint=all/protected either: javadoc rejects access qualifiers on -Xdoclint
              outright ("Access qualifiers not permitted for -Xdoclint arguments"), because
              visibility is already set by its own -public/-protected flag.

              Two things a reader should know about this plugin, both established by
              measurement during EOP-120 rather than assumed.

              Supply chain: this plugin is NOT covered by tools/supply-chain/. That tooling
              audits the seven OpenCode npm plugins only, and there is no checksum or GPG
              verification at the Maven layer, so a Maven plugin runs arbitrary code in the
              build JVM on the same terms as checkstyle, spotbugs, jacoco and liquibase
              already do. The version above is therefore pinned exactly, never a range.
              Accepted knowingly; moving the pin is a supply-chain change.

              Incremental runs, stated as what has actually been verified and no further.
              CI is always the cold path: .github/workflows/ci.yml checks out a fresh runner
              with no target/, so every merge is gated on a full analysis. Locally the goal is
              incremental and can log "Skipping javadoc generation, everything is up to date."
              Do NOT read that line, or the goal's mere presence in a warm log, as proof it
              re-analysed your edit. The plugin's staleness record
              (target/maven-javadoc-plugin-stale-data.txt) lists jars and the top-level files of
              the output directory and contains no .java path at all, so editing a Javadoc
              comment inside a source file need not invalidate it. If you have changed only
              comments, run "./mvnw clean verify" before pushing.

              debug=true below is load-bearing, not a leftover. Without it the plugin deletes
              the options, packages and argfile files after generating, while its own staleness
              check still tries to stat options; that made a warm "./mvnw verify" fail with
              "Unable to compute stale date: .../target/reports/apidocs/options" on a tree whose
              Java and Javadoc were both correct. Keeping those files makes the check stateable.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <configuration>
                    <show>public</show>
                    <doclint>all,-missing</doclint>
                    <failOnError>true</failOnError>
                    <failOnWarnings>true</failOnWarnings>
                    <quiet>true</quiet>
                    <notimestamp>true</notimestamp>
                    <debug>true</debug>
                </configuration>
                <executions>
                    <execution>
                        <id>verify-javadoc</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>javadoc-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <failOnError>true</failOnError>
                    <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>analyze-bugs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.min.instruction}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.min.branch}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-rules</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <dependencyConvergence/>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>log4j:log4j</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
