export JAVA_HOME="$(/usr/libexec/java_home -v 21 2>/dev/null || echo "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home")"
export PATH="$JAVA_HOME/bin:$PATH"
# Repo-local graphify CLI (tools/graphify, pinned) so the bare "graphify" command resolves
PATH_add tools/graphify/node_modules/.bin
dotenv
: "${MODEL_A:?}" "${MODEL_B:?}" "${MODEL_C:?}" "${MODEL_D:?}" "${MODEL_E:?}" "${MODEL_F:?}"

# Testcontainers (EOP-164) has to discover a Docker endpoint for itself, and on this project's
# container runtime it cannot. Testcontainers 2.0.5 does not read the docker CLI's active
# context, and Colima (ADR-016 -- Docker Desktop is deliberately not installed) puts its socket
# under ~/.colima rather than at /var/run/docker.sock, which does not exist here at all. Without
# DOCKER_HOST every migration IT fails with "Could not find a valid Docker environment".
#
# Guarded twice so it only fires where it is the right answer: an endpoint the developer has
# already chosen wins (this sits after "dotenv", so .env wins too), and the socket must actually
# be there, which leaves Docker Desktop and non-default Colima profiles untouched. CI needs none
# of this -- ubuntu-latest has the conventional socket.
#
# DOCKER_HOST alone is not enough, and the second variable is not optional. Testcontainers
# bind-mounts the socket into Ryuk, its reaper sidecar, and by default it mounts the literal path
# it resolved from DOCKER_HOST. That path is a macOS-side socket which does not exist inside the
# Colima VM, and virtiofs cannot conjure it, so the daemon rejects the mount with
# "error while creating mount source path ... operation not supported" and every IT errors in
# class initialisation. TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE names the path to mount instead --
# /var/run/docker.sock, which is where the real socket lives inside the VM. Ryuk stays enabled:
# TESTCONTAINERS_RYUK_DISABLED=true would also clear the error, by giving up reliable cleanup of
# stray containers, which is a worse trade than naming one path correctly.
if [ -z "${DOCKER_HOST:-}" ] && [ -S "$HOME/.colima/default/docker.sock" ]; then
  export DOCKER_HOST="unix://$HOME/.colima/default/docker.sock"
  export TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE="${TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE:-/var/run/docker.sock}"
fi
