// Configuration for @tarquinen/opencode-smart-title (Blueprint 12.9).
//
// This file is read by the plugin itself, NOT by opencode, and that has two
// consequences worth knowing before editing it:
//
//   1. There is no {env:VAR} interpolation here. opencode.json resolves
//      "{env:MODEL_B}"; this file does not -- the plugin parses it with a plain
//      jsonc-parser call. The model below is therefore a LITERAL that duplicates
//      MODEL_B's value, and the duplication has to be maintained by hand.
//
//   2. A project file overrides the global ~/.config/opencode/smart-title.jsonc,
//      which the plugin writes for itself on first run if it is missing. Keeping
//      this file committed is what stops the roster's titling behaviour from
//      depending on an untracked file in one developer's home directory.
//
// "model" is not optional in practice, even though the plugin treats it as such:
// its fallback list covers openai/anthropic/google/deepseek/xai/alibaba/zai/
// opencode and does NOT include amazon-bedrock, so with no model named the
// selector throws, the error is swallowed, and the plugin is inert-but-installed.
{
  "enabled": true,
  "debug": false,

  // MODEL_B's value, spelled out. Titling does not warrant the MODEL_A tier.
  "model": "amazon-bedrock/eu.anthropic.claude-sonnet-4-6",

  // Regenerate on every 3rd idle event, not every one. The plugin re-titles
  // repeatedly for the life of a session and sends the WHOLE conversation each
  // time with no length cap, so a threshold of 1 on a mid-tier model is more
  // spend than a session title is worth.
  "updateThreshold": 3
}
