{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian"],
      "enabled": true,
      "environment": {
        "JIRA_URL": "{env.JIRA_URL}",
        "JIRA_USERNAME": "opencodebot@btinternet.com",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
      }
    }
  },
  "plugin": [
    ".opencode/plugins/graphify.js"
  ]
}