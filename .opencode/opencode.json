{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/rules/clean-architecture.md",
    ".opencode/rules/security.md",
    ".opencode/rules/git-commits.md",
    ".opencode/rules/testing.md"
  ],
  "mcp": {
    "atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian==0.23.0"],
      "enabled": true,
      "environment": {
        "JIRA_URL": "{env:JIRA_URL}",
        "JIRA_USERNAME": "{env:JIRA_USERNAME}",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}",
        "X-MCP-Readonly": "true",
        "X-MCP-Toolsets": "repos,issues,pull_requests,actions"
      },
      "oauth": false,
      "timeout": 15000
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "rm *": "ask",
      "chmod 777 *": "ask",
      "git push --force*": "ask",
      "git push -f *": "ask",
      "git reset --hard*": "ask",
      "git clean -fd*": "ask",
      "* | sh": "ask",
      "* | bash": "ask",
      "* | zsh": "ask",
      "curl * | *": "ask",
      "wget * | *": "ask",
      "bash -c *": "ask",
      "sh -c *": "ask",
      "zsh -c *": "ask"
    },
    "atlassian_jira_*": "allow",
    "atlassian_jira_create_*": "ask",
    "atlassian_jira_batch_*": "ask",
    "atlassian_jira_batch_get_changelogs": "allow",
    "atlassian_jira_update_*": "ask",
    "atlassian_jira_add_*": "ask",
    "atlassian_jira_edit_comment": "ask",
    "atlassian_jira_assign_issue": "ask",
    "atlassian_jira_transition_issue": "ask",
    "atlassian_jira_link_to_epic": "ask",
    "atlassian_jira_remove_*": "ask",
    "atlassian_jira_move_*": "deny",
    "github_*": "deny",
    "github_get_*": "allow",
    "github_list_*": "allow",
    "github_search_*": "allow",
    "github_issue_read": "allow",
    "github_pull_request_read": "allow",
    "github_actions_*": "allow",
    "github_*_write": "deny"
  },
  "model": "{env:MODEL_A}",
  "small_model": "{env:MODEL_D}",
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "{env:AWS_REGION}"
      }
    }
  },
  "plugin": [
    "opencode-vibeguard@0.1.0",
    "@tarquinen/opencode-dcp@3.1.14",
    "opencode-supermemory@2.0.11",
    "@nick-vi/opencode-type-inject@1.5.2",
    "opencode-scheduler@1.3.0",
    ["opencode-goal-plugin@0.6.7", {
      "maxTurns": 10,
      "maxDurationMs": 900000,
      "maxTokens": 200000,
      "minDelayMs": 1500,
      "noProgressTokenThreshold": 50,
      "noProgressTurnsBeforePause": 2,
      "noToolCallTurnsBeforePause": 2,
      "persistState": true,
      "stateFilePath": ".opencode/goals/state.json"
    }]
  ],
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "team-member-tech-lead"
    }
  },
  "agent": {
    "expert-alex-xu": { "model": "{env:MODEL_A}" },
    "expert-uncle-bod": { "model": "{env:MODEL_A}" },
    "team-member-architecture-guardian": { "model": "{env:MODEL_A}" },
    "team-member-security-auditor": { "model": "{env:MODEL_A}" },
    "team-member-tech-lead": { "model": "{env:MODEL_A}" },
    "expert-dave-farley": { "model": "{env:MODEL_B}" },
    "expert-kent-beck": { "model": "{env:MODEL_B}" },
    "team-member-code-reviewer": { "model": "{env:MODEL_B}" },
    "team-member-product-owner": { "model": "{env:MODEL_B}" },
    "team-member-db-designer": { "model": "{env:MODEL_C}" },
    "team-member-devops-engineer": { "model": "{env:MODEL_C}" },
    "team-member-performance-engineer": { "model": "{env:MODEL_C}" },
    "team-member-tester-api": { "model": "{env:MODEL_C}" },
    "team-member-tester-unit-and-quality": { "model": "{env:MODEL_C}" },
    "team-member-ui-builder": { "model": "{env:MODEL_E}" }
  }
}
