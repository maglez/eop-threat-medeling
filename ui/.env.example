# Copy this file to .env.local and set values for local development.
# These are Vite build-time feature flags — they are baked in at build time,
# not read at runtime. Changing them requires a rebuild (or `npm run dev` restart).

# Enable the game screen (mounts when the session transitions to IN_PROGRESS).
# Set to true for local development; the server-side flag eop.features.trick-play
# must also be true (it is, by default since EOP-70).
VITE_GAME_SCREEN_ENABLED=true

# Enable the card magnifier — a circular lens that follows the pointer over a
# hand card or a trick-zone card and scales the pixels beneath it 2x (EOP-145).
# Purely presentational: there is no server-side counterpart to this flag, and
# nothing under eop.features.* governs it.
VITE_CARD_MAGNIFIER_ENABLED=true

# Enable the proactive follow-suit hint — an inline message telling the active
# player which suit they must follow before they attempt an illegal play
# (EOP-168). Purely presentational: the rule itself is enforced server-side by
# MustFollowSuitException regardless of this flag, and nothing under
# eop.features.* governs it.
VITE_FOLLOW_SUIT_HINT_ENABLED=true
