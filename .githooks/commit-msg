#!/bin/sh
#
# Enforces the commit convention from Blueprint §7.5 and
# .opencode/rules/git-commits.md:
#
#     [EOP-NNN] <type>: <short summary>
#
# Activated per clone with:  git config core.hooksPath .githooks
# That command cannot be committed, so a clone without it has this hook
# present but inert. See SETUP.md.

set -eu

msg_file="$1"

# Merge commits are generated by git, not authored, so they are exempt.
# `git merge` writes MERGE_HEAD before the hook runs.
git_dir=$(git rev-parse --git-dir)
if [ -f "$git_dir/MERGE_HEAD" ]; then
    exit 0
fi

# First line that is neither blank nor a comment.
subject=$(grep -v '^#' "$msg_file" | grep -v '^[[:space:]]*$' | head -n 1 || true)

case "$subject" in
    # Autosquash markers are rewritten by `rebase --autosquash`, and a revert
    # keeps the reverted commit's own key inside the quotes.
    fixup!*|squash!*|amend!*|'Revert "'*)
        exit 0
        ;;
esac

if ! printf '%s' "$subject" | grep -Eq '^\[EOP-[0-9]+\] (feat|fix|chore|docs|refactor|test|perf): .+'; then
    cat >&2 <<EOF
commit rejected: subject does not match the required convention.

  got:      ${subject:-<empty>}
  expected: [EOP-NNN] <type>: <short summary>
  types:    feat, fix, chore, docs, refactor, test, perf

  example:  [EOP-12] feat: implement card dealing animation

The Jira key is mandatory and uppercase. See .opencode/rules/git-commits.md.
Bypass only with a stated reason: git commit --no-verify
EOF
    exit 1
fi
