{
  "title": "k6 Load Testing",
  "uid": "k6-load-testing",
  "description": "Real-time and historical k6 load test results from InfluxDB",
  "tags": ["k6", "performance", "load-testing"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "panels": [
    {
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "title": "p95 Latency",
      "type": "stat",
      "description": "Current 95th percentile request duration",
      "pluginVersion": "9.0.0",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "ms",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "groupBy": [],
          "measurement": "http_req_duration",
          "orderByTime": "ASC",
          "policy": "default",
          "refId": "A",
          "resultFormat": "time_series",
          "select": [
            [
              { "params": ["p(95)"], "type": "field" },
              { "params": [], "type": "last" }
            ]
          ],
          "tags": []
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "title": "Requests / sec",
      "type": "stat",
      "description": "Current request throughput",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "reqps",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "groupBy": [],
          "measurement": "http_reqs",
          "orderByTime": "ASC",
          "policy": "default",
          "refId": "A",
          "resultFormat": "time_series",
          "select": [
            [
              { "params": ["rate"], "type": "field" },
              { "params": [], "type": "last" }
            ]
          ],
          "tags": []
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "title": "Error Rate",
      "type": "stat",
      "description": "Current percentage of failed requests",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.1 }
            ]
          },
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "groupBy": [],
          "measurement": "http_req_failed",
          "orderByTime": "ASC",
          "policy": "default",
          "refId": "A",
          "resultFormat": "time_series",
          "select": [
            [
              { "params": ["rate"], "type": "field" },
              { "params": [], "type": "last" },
              { "params": [], "type": "math", "expression": "$ * 100" }
            ]
          ],
          "tags": []
        }
      ]
    },
    {
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "title": "Active VUs",
      "type": "stat",
      "description": "Current number of active virtual users",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "groupBy": [],
          "measurement": "vus",
          "orderByTime": "ASC",
          "policy": "default",
          "refId": "A",
          "resultFormat": "time_series",
          "select": [
            [
              { "params": ["value"], "type": "field" },
              { "params": [], "type": "last" }
            ]
          ],
          "tags": []
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Latency Percentiles",
      "type": "timeseries",
      "description": "Response time percentiles over time",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "ms",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [
              { "id": "custom.lineWidth", "value": 3 },
              { "id": "color", "value": { "fixed": "red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [
              { "id": "custom.lineWidth", "value": 2 },
              { "id": "custom.lineStyle", "value": { "fill": "dash" } },
              { "id": "color", "value": { "fixed": "dark-red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p50" },
            "properties": [
              { "id": "color", "value": { "fixed": "blue" } }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max", "mean"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "groupBy": [
            { "params": ["$__interval"], "type": "time" },
            { "params": ["none"], "type": "fill" }
          ],
          "measurement": "http_req_duration",
          "orderByTime": "ASC",
          "policy": "default",
          "refId": "p50",
          "resultFormat": "time_series",
          "select": [
            [
              { "params": ["p(50)"], "type": "field" },
              { "params": [], "type": "mean" },
              { "params": ["p50"], "type": "alias" }
            ]
          ],
          "tags": []
        },
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "groupBy": [
            { "params": ["$__interval"], "type": "time" },
            { "params": ["none"], "type": "fill" }
          ],
          "hide": false,
          "measurement": "http_req_duration",
          "orderByTime": "ASC",
          "policy": "default",
          "refId": "p95",
          "resultFormat": "time_series",
          "select": [
            [
              { "params": ["p(95)"], "type": "field" },
              { "params": [], "type": "mean" },
              { "params": ["p95"], "type": "alias" }
            ]
          ],
          "tags": []
        },
        {
          "datasource": { "type": "influxdb", "uid": "InfluxDB" },
          "groupBy": [
            { "params": ["$__interval"], "type": "time" },
            { "params": ["none"], "type": "fill" }
          ],
          "hide": false,
          "measurement": "http_req_duration",
          "orderByTime": "ASC",
          "policy": "default",
          "refId": "p99",
          "resultFormat": "time_series",
          "select": [
            [
              { "params": ["p(99)"], "type": "field" },
              { "params": [], "type": "mean" },
              { "params": ["p99"], "type": "alias" }
            ]
          ],
          "tags": []
        }
      ]
    },
    {
