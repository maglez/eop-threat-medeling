# Required
OPENAI_API_KEY=sk-example0123456789abcdef
OPENAI_BASE_URL=https://api.openai.com/v1
GITHUB_TOKEN=ghp_example0123456789abcdef0123456789abcde
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=you@example.com
JIRA_API_TOKEN=ATATT3xFfGF0exampleTokenValue123=

# Optional
SUPERMEMORY_API_KEY=sm_exampleKey0123456789abcdef0123456789abcdef0123

# Grafana (admin account seeded on first boot; pick strong passwords)
# Wrap passwords in single quotes if they contain $ (compose/direnv interpolation)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD='Str0ng!Ex@mpleP@ss'

# Database (local dev defaults shown; production uses DATASOURCE_* in application-prod.yml)
DB_URL=jdbc:h2:mem:eop
DB_USERNAME=sa
DB_PASSWORD=

# InfluxDB (admin account seeded on first boot; you choose these values)
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_USER=admin
INFLUXDB_PASSWORD='ExampleInfluxP@ss1'
