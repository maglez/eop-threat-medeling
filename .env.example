# AI provider — no env vars required.
# OpenCode Zen is a built-in provider (id `opencode`). Authenticate with
# `/connect` in the TUI; the key is stored in
# ~/.local/share/opencode/auth.json, never in .env. See Blueprint §3.4.

# Required
JAVA_HOME=/usr/local/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home
GITHUB_TOKEN=ghp_example0123456789abcdef0123456789abcde
JIRA_URL=https://your-domain.atlassian.net
JIRA_PROJECT_KEY=EOP
JIRA_USERNAME=you@example.com
JIRA_API_TOKEN=ATATT3xFfGF0exampleTokenValue123=

# Optional
SUPERMEMORY_API_KEY=sm_exampleKey0123456789abcdef0123456789abcdef0123

# Grafana (admin account seeded on first boot; pick strong passwords)
# Wrap passwords in single quotes if they contain $ (compose/direnv interpolation)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD='Str0ng!Ex@mpleP@ss'

# Database (local dev defaults shown; production uses DATASOURCE_* in application-prod.yml)
DB_URL=jdbc:h2:mem:eop
DB_USERNAME=sa
DB_PASSWORD=

# InfluxDB (admin account seeded on first boot; you choose these values)
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_USER=admin
INFLUXDB_PASSWORD='ExampleInfluxP@ss1'

# Containerised stack (compose.app.yml). Used by `docker compose -f compose.app.yml up`.
# On EC2 these same variables are written to /opt/eop/.env by Terraform user-data.
POSTGRES_DB=eop
POSTGRES_USER=eop
POSTGRES_PASSWORD='choose-a-strong-value'
# Pin overridden by infra/variables.tf on the instance; this is the local default.
POSTGRES_IMAGE=postgres:17-alpine
# Named volume locally; an absolute EBS-backed path on the instance.
# POSTGRES_DATA_DIR=eop_postgres_data
# Build locally with `docker build -t eop-threat-medeling:local .`, or point at an
# immutable GHCR tag published by CI.
APP_IMAGE=eop-threat-medeling:local
# 127.0.0.1 locally so the app is not exposed off the machine; 0.0.0.0 on the instance.
APP_BIND=127.0.0.1

# Production datasource (application-prod.yml). compose.app.yml OVERRIDES these with
# the PostgreSQL service name, because a localhost URL inside the app container means
# the container itself. They are listed here for a bare `java -jar -Dspring.profiles.active=prod`.
DATASOURCE_URL=jdbc:postgresql://localhost:5432/eop
DATASOURCE_USER=eop
DATASOURCE_PASSWORD='choose-a-strong-value'
